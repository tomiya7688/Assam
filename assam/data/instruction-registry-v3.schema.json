{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assam:schemas:instruction-registry:v3",
  "title": "ASSAM instruction registry v3",
  "description": "Instruction contract shared by all implementations. Holds contract and mapping information only; execution logic lives in each implementation.",
  "type": "object",
  "required": ["schema_version", "profiles", "instructions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 3},
    "profiles": {
      "type": "object",
      "required": ["full", "core"],
      "additionalProperties": false,
      "properties": {
        "full": {"type": "object"},
        "core": {
          "type": "object",
          "required": ["versions"],
          "additionalProperties": false,
          "properties": {"versions": {"type": "array", "minItems": 1, "items": {"enum": ["draft", "1"]}}}
        }
      }
    },
    "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instruction"}}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
    "operand": {
      "type": "object",
      "required": ["role", "kind", "access"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["register", "immediate", "symbol", "memory_offset", "helper_id", "trap_code", "value", "integer", "address", "name", "target"]
        },
        "access": {"enum": ["read", "write", "none"]},
        "min": {"$ref": "#/$defs/decimal"},
        "max": {"$ref": "#/$defs/decimal"}
      }
    },
    "availability": {
      "type": "object",
      "required": ["profile"],
      "additionalProperties": false,
      "properties": {"profile": {"enum": ["core", "full"]}, "since": {"enum": ["draft", "1"]}}
    },
    "memory": {
      "type": "object",
      "required": ["read", "write", "width_bits"],
      "additionalProperties": false,
      "properties": {
        "read": {"type": "boolean"},
        "write": {"type": "boolean"},
        "width_bits": {"enum": [null, 8, 16, 32, 64]}
      }
    },
    "instruction": {
      "type": "object",
      "required": ["id", "mnemonic", "availability", "operands", "effects", "classification"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^(core|draft|full)\\.[a-z][a-z0-9]*$"},
        "mnemonic": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "availability": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/availability"}},
        "full_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "operands": {"type": "array", "items": {"$ref": "#/$defs/operand"}},
        "width": {
          "type": "object",
          "required": ["bits", "signedness"],
          "additionalProperties": false,
          "properties": {"bits": {"enum": [8, 16, 32, 64]}, "signedness": {"enum": ["signed", "unsigned", "agnostic"]}}
        },
        "effects": {
          "type": "object",
          "required": ["memory", "control"],
          "additionalProperties": false,
          "properties": {
            "registers": {"const": "by_operand"},
            "memory": {"$ref": "#/$defs/memory"},
            "control": {"enum": ["next", "jump", "conditional", "link", "indirect", "halt", "trap", "call", "return"]}
          }
        },
        "traps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["div_by_zero", "memory_out_of_range", "invalid_jump_target", "unknown_helper", "explicit"]}
        },
        "integer_operands": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "trap_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "operand_positions"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["division_by_zero", "negative_shift_count", "call_stack_underflow", "data_stack_underflow"]},
              "operand_positions": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
            }
          }
        },
        "semantics": {"type": "string", "pattern": "^doc/jp/.+\\.md#.+$"},
        "target_mapping_id": {"type": "string", "pattern": "^assam\\.core\\.(draft|1)\\.[a-z][a-z0-9_]*$"},
        "classification": {"enum": ["ordinary", "abi_primitive"]}
      },
      "allOf": [
        {
          "if": {"properties": {"id": {"pattern": "^core\\."}}},
          "then": {
            "required": ["width", "traps", "semantics", "target_mapping_id", "full_names"],
            "not": {"anyOf": [{"required": ["trap_conditions"]}, {"required": ["integer_operands"]}]}
          },
          "else": {"not": {"anyOf": [{"required": ["traps"]}, {"required": ["width"]}, {"required": ["full_names"]}]}}
        }
      ]
    }
  }
}
