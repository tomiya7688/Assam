{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:assam:schemas:program-ir:v1",
  "title": "ASSAM JSON intermediate representation v1",
  "description": "Canonical JSON shape emitted by Program.to_json. Runtime semantic validation adds opcode, operand, and label-target checks.",
  "type": "object",
  "required": ["instructions", "labels"],
  "properties": {
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["opcode", "operands"],
        "properties": {
          "opcode": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "operands": {
            "type": "array",
            "items": true
          }
        },
        "additionalProperties": false
      }
    },
    "labels": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "profile": {
      "type": "object",
      "required": ["name", "version", "registry_schema_version"],
      "properties": {
        "name": {"type": "string", "const": "Assam Core"},
        "version": {"type": "string", "const": "draft"},
        "registry_schema_version": {"type": "integer", "const": 2}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
